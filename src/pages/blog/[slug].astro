---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const sectionHeadings = headings.filter((h) => h.depth === 2);

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const aSame = a.data.section === post.data.section ? 1 : 0;
    const bSame = b.data.section === post.data.section ? 1 : 0;
    if (aSame !== bSame) return bSame - aSame;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  }).format(date);

const articleUrl = `https://mob.tec.br/blog/${post.id}`;
const coverAbsoluteUrl = new URL(post.data.coverImage, 'https://mob.tec.br').toString();
const whatsappMessage = encodeURIComponent(
  `Olá Osmar! Li o artigo "${post.data.title}" no blog da MOB e quero entender como implantar IA na minha empresa.`
);

const articleSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: coverAbsoluteUrl,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    inLanguage: 'pt-BR',
    mainEntityOfPage: articleUrl,
    author: {
      '@type': 'Person',
      name: post.data.author,
    },
    publisher: {
      '@type': 'Organization',
      name: 'MOB | Inteligência Artificial para Empresas',
      url: 'https://mob.tec.br',
      logo: {
        '@type': 'ImageObject',
        url: 'https://mob.tec.br/favicon.svg',
      },
    },
    articleSection: post.data.section,
    keywords: post.data.keywords.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://mob.tec.br/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://mob.tec.br/blog' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
    ],
  },
];
---

<Layout
  title={`${post.data.title} | Blog MOB`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.coverImage}
  publishedTime={post.data.publishedAt.toISOString()}
  jsonLd={articleSchema}
>
  <div
    aria-hidden="true"
    class="fixed top-0 inset-x-0 z-[60] h-[2px] bg-transparent pointer-events-none motion-reduce:hidden"
  >
    <div
      id="reading-progress"
      class="h-full w-full origin-left scale-x-0 bg-amber-400 transition-transform duration-75 ease-out"
    ></div>
  </div>

  <Navbar currentPage="blog" />

  <main class="bg-[#020202] text-white pt-32 pb-24 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto">
      <nav aria-label="Navegação estrutural" class="mb-8 text-sm text-zinc-400 flex flex-wrap items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Início</a>
        <span aria-hidden="true" class="text-zinc-600">/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span aria-hidden="true" class="text-zinc-600">/</span>
        <span class="text-amber-400 font-medium">{post.data.section}</span>
      </nav>

      <header class="max-w-3xl">
        <h1 class="text-3xl sm:text-5xl font-bold tracking-[-0.03em] text-white leading-[1.1] text-balance">
          {post.data.title}
        </h1>

        <p class="mt-5 text-lg sm:text-xl text-zinc-300 leading-relaxed max-w-[62ch]">
          {post.data.description}
        </p>

        <div class="mt-7 pt-6 border-t border-white/[0.08] flex flex-wrap items-center justify-between gap-4 text-sm text-zinc-400">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/[0.06] border border-white/10 text-amber-300 font-semibold flex items-center justify-center text-xs">
              OH
            </div>
            <div>
              <div class="text-white font-medium">{post.data.author}</div>
              <div class="text-xs text-zinc-400">Fundador da MOB · Implantação prática de IA</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 text-sm text-zinc-400 tabular-nums">
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
            <span aria-hidden="true" class="text-zinc-600">·</span>
            <span>{post.data.readingTime}</span>
          </div>
        </div>
      </header>

      <figure class="mt-10 mb-14">
        <div class="overflow-hidden rounded-2xl border border-white/[0.09] bg-[#09090d] aspect-[16/9]">
          <img
            src={post.data.coverImage}
            alt={post.data.coverAlt}
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        {post.data.coverCaption && (
          <figcaption class="mt-3 text-sm text-zinc-400 leading-relaxed">
            {post.data.coverCaption}
          </figcaption>
        )}
      </figure>

      <div class="grid grid-cols-1 lg:grid-cols-[220px_minmax(0,68ch)] lg:gap-16 items-start">
        {sectionHeadings.length >= 2 && (
          <aside aria-label="Seções deste artigo" class="lg:sticky lg:top-28 mb-10 lg:mb-0">
            <details class="lg:hidden rounded-xl border border-white/[0.08] bg-[#08080c] p-4" open>
              <summary class="flex items-center justify-between text-sm font-semibold text-white cursor-pointer list-none">
                <span>Seções deste artigo</span>
                <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <ol class="mt-3 pt-3 border-t border-white/[0.06] space-y-2.5 text-sm text-zinc-300">
                {sectionHeadings.map((heading, idx) => (
                  <li>
                    <a href={`#${heading.slug}`} class="flex items-baseline gap-2.5 hover:text-amber-300 transition-colors">
                      <span class="text-xs font-mono text-zinc-500 tabular-nums">
                        {String(idx + 1).padStart(2, '0')}
                      </span>
                      <span>{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>

            <div class="hidden lg:block">
              <div class="text-sm font-semibold text-white mb-4">
                Neste artigo
              </div>
              <nav class="border-l border-white/[0.08] space-y-1">
                {sectionHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link={heading.slug}
                    class="toc-link block pl-4 py-1.5 -ml-px border-l border-transparent text-sm text-zinc-400 hover:text-white transition-colors duration-150 leading-snug"
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>

              <div class="mt-8 pt-6 border-t border-white/[0.08] space-y-3 text-sm">
                <a
                  href="/#precos"
                  class="block text-zinc-400 hover:text-amber-300 transition-colors"
                >
                  Simular retorno (ROI) →
                </a>
                <a
                  href="/blog"
                  class="block text-zinc-400 hover:text-white transition-colors"
                >
                  ← Voltar para o blog
                </a>
              </div>
            </div>
          </aside>
        )}

        <div class="min-w-0">
          <article id="article-content" class="mob-prose max-w-[68ch]">
            <Content />
          </article>

          <section
            aria-label="Próximo passo com a MOB"
            class="mt-16 p-7 sm:p-9 rounded-2xl bg-[#08080c] border border-white/[0.1]"
          >
            <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.025em] text-white leading-tight text-balance">
              Quer colocar IA funcionando na sua rotina sem perder meses em testes?
            </h2>
            <p class="mt-3.5 text-base text-zinc-300 leading-relaxed">
              Com o <strong class="text-white">MOB Start</strong> (nuvem privada dedicada para todo o Brasil) ou a <strong class="text-white">MOB Box</strong> (servidor físico em Blumenau e região), configuramos seus assistentes com as regras da sua empresa em até 72 horas.
            </p>
            <div class="mt-6 flex flex-col sm:flex-row gap-3">
              <a
                href={`https://wa.me/5547988131910?text=${whatsappMessage}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 min-h-[48px] rounded-full text-sm font-semibold bg-amber-400 text-black hover:bg-amber-300 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#08080c]"
              >
                <span>Agendar demonstração de 15 min</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a
                href="/#precos"
                class="inline-flex items-center justify-center px-6 py-3.5 min-h-[48px] rounded-full text-sm font-medium text-zinc-200 hover:text-white bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 transition-colors duration-150"
              >
                Ver planos e calculadora
              </a>
            </div>
          </section>
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <section aria-label="Leia também" class="mt-24 pt-14 border-t border-white/[0.08]">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
            <div>
              <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.02em] text-white">
                Leia também
              </h2>
              <p class="mt-1 text-sm sm:text-base text-zinc-400">
                Continue explorando guias práticos para decidir com segurança.
              </p>
            </div>
            <a
              href="/blog"
              class="text-sm font-medium text-amber-400 hover:text-amber-300 transition-colors"
            >
              Ver todos os artigos →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
            {relatedPosts.map((related) => (
              <a
                href={`/blog/${related.id}`}
                class="group flex flex-col justify-between rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/80 focus-visible:ring-offset-4 focus-visible:ring-offset-[#020202]"
              >
                <div>
                  <div class="overflow-hidden rounded-xl border border-white/[0.08] bg-[#09090d] aspect-[16/9] mb-4">
                    <img
                      src={related.data.coverImage}
                      alt={related.data.coverAlt}
                      width="1280"
                      height="720"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transform-none"
                    />
                  </div>

                  <div class="flex items-center gap-2 text-xs text-zinc-400 mb-2 tabular-nums">
                    <span class="text-amber-400 font-medium">{related.data.section}</span>
                    <span aria-hidden="true" class="text-zinc-600">·</span>
                    <span>{related.data.readingTime}</span>
                  </div>

                  <h3 class="text-lg font-bold tracking-[-0.015em] text-white group-hover:text-amber-300 transition-colors duration-200 leading-snug mb-2">
                    {related.data.title}
                  </h3>

                  <p class="text-sm text-zinc-400 leading-relaxed line-clamp-3">
                    {related.data.description}
                  </p>
                </div>

                <div class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-200 group-hover:text-amber-300 transition-colors">
                  <span>Ler artigo</span>
                  <svg
                    class="w-3.5 h-3.5 transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transform-none"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <Footer />

  <script is:inline>
    (function initArticleEnhancements() {
      const progressEl = document.getElementById('reading-progress');
      const articleEl = document.getElementById('article-content');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (progressEl && articleEl && !reducedMotion) {
        const updateProgress = () => {
          const rect = articleEl.getBoundingClientRect();
          const total = Math.max(1, articleEl.offsetHeight - window.innerHeight * 0.65);
          const scrolled = Math.min(total, Math.max(0, -rect.top + window.innerHeight * 0.15));
          progressEl.style.transform = `scaleX(${scrolled / total})`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }

      const tocLinks = Array.from(document.querySelectorAll('.toc-link'));
      if (!tocLinks.length || !articleEl) return;

      const headings = tocLinks
        .map((link) => {
          const id = link.getAttribute('data-toc-link');
          return id ? document.getElementById(id) : null;
        })
        .filter(Boolean);

      if (!headings.length) return;

      const setActive = (activeId) => {
        tocLinks.forEach((link) => {
          const isMatch = link.getAttribute('data-toc-link') === activeId;
          if (isMatch) {
            link.classList.add('text-amber-300', 'border-amber-400', 'font-medium');
            link.classList.remove('text-zinc-400', 'border-transparent');
          } else {
            link.classList.remove('text-amber-300', 'border-amber-400', 'font-medium');
            link.classList.add('text-zinc-400', 'border-transparent');
          }
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0 && visible[0].target.id) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: '-18% 0px -65% 0px', threshold: 0 }
      );

      headings.forEach((h) => observer.observe(h));
      setActive(headings[0].id);
    })();
  </script>
</Layout>

<style is:global>
  .mob-prose {
    color: #e4e4e7;
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .mob-prose h2 {
    color: #ffffff;
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.24;
    margin-top: 3.25rem;
    margin-bottom: 1rem;
    padding-top: 2.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 7.5rem;
  }

  .mob-prose h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .mob-prose h3 {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 7.5rem;
  }

  .mob-prose p {
    margin-bottom: 1.3rem;
  }

  .mob-prose strong {
    color: #ffffff;
    font-weight: 600;
  }

  .mob-prose a {
    color: #fbbf24;
    text-decoration: underline;
    text-decoration-color: rgba(251, 191, 36, 0.45);
    text-underline-offset: 4px;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .mob-prose a:hover {
    color: #fcd34d;
    text-decoration-color: #fcd34d;
  }

  .mob-prose ul,
  .mob-prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.4rem;
  }

  .mob-prose ul {
    list-style-type: disc;
  }

  .mob-prose ol {
    list-style-type: decimal;
  }

  .mob-prose li {
    margin-bottom: 0.6rem;
    padding-left: 0.25rem;
  }

  .mob-prose li::marker {
    color: #fbbf24;
  }

  .mob-prose blockquote {
    margin: 2.5rem 0;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.55;
    color: #f4f4f5;
  }

  .mob-prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .mob-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2.25rem 0;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    display: block;
    overflow-x: auto;
  }

  .mob-prose thead {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .mob-prose th {
    text-align: left;
    padding: 0.85rem 1rem;
    color: #ffffff;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.03);
  }

  .mob-prose td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: #d4d4d8;
    vertical-align: top;
  }

  .mob-prose hr {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 2.5rem 0;
  }
</style>
