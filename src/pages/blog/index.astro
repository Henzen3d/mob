---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const sections = [
  'Todos',
  'Como Começar',
  'Custos e Retorno',
  'Segurança e LGPD',
  'IA por Setor',
] as const;

const featuredPost = allPosts.find((post) => post.data.featured) ?? allPosts[0];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date);

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog MOB | Inteligência Artificial para Empresas',
  description:
    'Guias práticos e diretos para donos de PMEs implementarem Inteligência Artificial na operação com retorno real e segurança LGPD.',
  url: 'https://mob.tec.br/blog',
  publisher: {
    '@type': 'Organization',
    name: 'MOB | Inteligência Artificial para Empresas',
    url: 'https://mob.tec.br',
  },
};
---

<Layout
  title="Blog MOB | Como implementar IA na sua empresa sem teoria"
  description="Artigos práticos para donos e gestores de PMEs em todo o Brasil: como implementar IA, evitar erros comuns, calcular o retorno e proteger dados na LGPD."
  jsonLd={blogSchema}
>
  <Navbar currentPage="blog" />

  <main class="bg-[#020202] text-white pt-32 pb-24 px-4">
    <div class="max-w-6xl mx-auto">
      <header class="max-w-3xl mb-14">
        <p class="text-sm font-medium text-amber-400 mb-3">
          Blog MOB • Guias práticos para PMEs
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white leading-[1.1] text-balance">
          Inteligência Artificial explicada para quem toca a empresa.
        </h1>
        <p class="mt-5 text-base sm:text-lg text-zinc-300 leading-relaxed">
          Sem jargão técnico e sem teoria de palco. Guias diretos sobre como colocar IA funcionando nos orçamentos, contratos e rotinas do seu negócio — com segurança e retorno medido.
        </p>
      </header>

      {featuredPost && (
        <section aria-label="Artigo em destaque" class="mb-14">
          <a
            href={`/blog/${featuredPost.id}`}
            class="group block p-7 sm:p-10 rounded-2xl bg-[#08080c] border border-amber-400/35 hover:border-amber-400/70 transition-all duration-200 hover:-translate-y-0.5"
          >
            <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-400 mb-4">
              <span class="px-3 py-1 rounded-full bg-amber-400/15 text-amber-300 font-medium">
                Guia principal • {featuredPost.data.section}
              </span>
              <span>{featuredPost.data.readingTime}</span>
              <span>•</span>
              <time datetime={featuredPost.data.publishedAt.toISOString()}>
                {formatDate(featuredPost.data.publishedAt)}
              </time>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-white group-hover:text-amber-300 transition-colors leading-snug max-w-3xl">
              {featuredPost.data.title}
            </h2>

            <p class="mt-3 text-base text-zinc-300 leading-relaxed max-w-3xl">
              {featuredPost.data.description}
            </p>

            <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-amber-400">
              <span>Ler artigo completo</span>
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        </section>
      )}

      <section aria-label="Todos os artigos">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-8 border-b border-white/[0.08]">
          <h2 class="text-2xl font-bold text-white tracking-tight">
            Todos os artigos
          </h2>

          <div
            id="section-filters"
            class="flex flex-wrap items-center gap-2"
            role="tablist"
            aria-label="Filtrar artigos por seção"
          >
            {sections.map((section, idx) => {
              const count =
                section === 'Todos'
                  ? allPosts.length
                  : allPosts.filter((p) => p.data.section === section).length;
              return (
                <button
                  type="button"
                  role="tab"
                  aria-selected={idx === 0 ? 'true' : 'false'}
                  data-filter={section}
                  class={`filter-btn min-h-[40px] px-4 py-2 rounded-full text-sm font-medium transition-colors ${
                    idx === 0
                      ? 'bg-white text-black'
                      : 'bg-white/[0.05] text-zinc-300 hover:bg-white/[0.1] hover:text-white border border-white/[0.08]'
                  }`}
                >
                  {section}
                  <span class="ml-1.5 text-xs opacity-70">({count})</span>
                </button>
              );
            })}
          </div>
        </div>

        <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {allPosts.map((post) => (
            <article
              data-section={post.data.section}
              class="post-card group rounded-2xl bg-[#08080c] border border-white/[0.08] hover:border-white/25 transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between"
            >
              <a href={`/blog/${post.id}`} class="p-6 sm:p-7 flex flex-col justify-between h-full">
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs text-zinc-400 mb-4">
                    <span class="px-2.5 py-1 rounded-full bg-white/[0.05] text-amber-300 border border-white/[0.08] font-medium">
                      {post.data.section}
                    </span>
                    <span>{post.data.readingTime}</span>
                  </div>

                  <h3 class="text-xl font-bold text-white group-hover:text-amber-300 transition-colors leading-snug mb-3">
                    {post.data.title}
                  </h3>

                  <p class="text-sm sm:text-base text-zinc-300 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-white/[0.06] flex items-center justify-between text-sm">
                  <time
                    class="text-xs text-zinc-400"
                    datetime={post.data.publishedAt.toISOString()}
                  >
                    {formatDate(post.data.publishedAt)}
                  </time>
                  <span class="inline-flex items-center gap-1.5 font-semibold text-white group-hover:text-amber-300 transition-colors">
                    Ler guia
                    <svg
                      class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>

        <div
          id="empty-filter-state"
          class="hidden py-14 px-6 text-center rounded-2xl bg-[#08080c] border border-white/[0.08]"
        >
          <p class="text-base text-zinc-300 mb-2">
            Novos artigos desta seção entram no ar nos próximos dias.
          </p>
          <button
            type="button"
            id="reset-filter-btn"
            class="mt-3 px-5 py-2.5 rounded-full text-sm font-semibold bg-white text-black hover:bg-zinc-200 transition-colors"
          >
            Ver todos os artigos publicados
          </button>
        </div>
      </section>

      <section class="mt-20 p-8 sm:p-10 rounded-2xl bg-[#08080c] border border-white/[0.1] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-amber-400 mb-2">
            Atendimento em todo o Brasil • MOB Start
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Quer tirar a IA do papel na sua empresa sem montar equipe de TI?
          </h2>
          <p class="mt-3 text-base text-zinc-300 leading-relaxed">
            Com o <strong class="text-white">MOB Start</strong>, configuramos sua nuvem privada dedicada com suas tabelas, propostas e regras comerciais em até 72 horas — com treinamento ao vivo para toda a equipe, em qualquer cidade do Brasil.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto shrink-0">
          <a
            href="https://wa.me/5547988131910?text=Ol%C3%A1%20Osmar!%20Estava%20lendo%20o%20blog%20da%20MOB%20e%20quero%20entender%20como%20implantar%20o%20MOB%20Start%20na%20minha%20empresa."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 min-h-[48px] rounded-full text-sm font-semibold bg-amber-400 text-black hover:bg-amber-300 transition-colors"
          >
            <span>Agendar demonstração de 15 min</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/#precos"
            class="inline-flex items-center justify-center px-6 py-3.5 min-h-[48px] rounded-full text-sm font-medium text-zinc-200 hover:text-white bg-white/[0.06] hover:bg-white/[0.12] border border-white/10 transition-colors"
          >
            Ver planos e preços
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script is:inline>
    (function initBlogFilters() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.post-card');
      const emptyState = document.getElementById('empty-filter-state');
      const resetBtn = document.getElementById('reset-filter-btn');

      if (!buttons.length || !cards.length) return;

      const applyFilter = (selected) => {
        let visibleCount = 0;

        buttons.forEach((btn) => {
          const isSelected = btn.getAttribute('data-filter') === selected;
          btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          if (isSelected) {
            btn.className = 'filter-btn min-h-[40px] px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white text-black';
          } else {
            btn.className = 'filter-btn min-h-[40px] px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white/[0.05] text-zinc-300 hover:bg-white/[0.1] hover:text-white border border-white/[0.08]';
          }
        });

        cards.forEach((card) => {
          const cardSection = card.getAttribute('data-section');
          const matches = selected === 'Todos' || cardSection === selected;
          card.classList.toggle('hidden', !matches);
          if (matches) visibleCount++;
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter') || 'Todos';
          applyFilter(filter);
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => applyFilter('Todos'));
      }
    })();
  </script>
</Layout>
