---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const sections = [
  'Todos',
  'Como Começar',
  'Custos e Retorno',
  'Segurança e LGPD',
  'IA por Setor',
] as const;

const featuredPost = allPosts.find((post) => post.data.featured) ?? allPosts[0];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date);

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog MOB | Inteligência Artificial para Empresas',
  description:
    'Guias práticos e diretos para donos de PMEs implementarem Inteligência Artificial na operação com retorno real e segurança LGPD.',
  url: 'https://mob.tec.br/blog',
  publisher: {
    '@type': 'Organization',
    name: 'MOB | Inteligência Artificial para Empresas',
    url: 'https://mob.tec.br',
  },
};
---

<Layout
  title="Blog MOB | Como implementar IA na sua empresa sem teoria"
  description="Artigos práticos para donos e gestores de PMEs em todo o Brasil: como implementar IA, evitar erros comuns, calcular o retorno e proteger dados na LGPD."
  ogImage={featuredPost?.data.coverImage}
  jsonLd={blogSchema}
>
  <Navbar currentPage="blog" />

  <main class="bg-[#020202] text-white pt-32 pb-24 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <header class="pb-12 mb-14 border-b border-white/[0.08]">
        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-bold tracking-[-0.03em] text-white leading-[1.08] text-balance max-w-4xl">
          Inteligência Artificial explicada para quem toca a empresa.
        </h1>
        <p class="mt-5 text-base sm:text-lg text-zinc-300 leading-relaxed max-w-[62ch]">
          Guias práticos e sem jargão técnico sobre como colocar IA funcionando nos orçamentos, contratos e rotinas do seu negócio — com dados reais, segurança na LGPD e retorno mensurável.
        </p>
      </header>

      {featuredPost && (
        <section aria-label="Artigo em destaque" class="mb-20">
          <a
            href={`/blog/${featuredPost.id}`}
            class="group grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/80 focus-visible:ring-offset-4 focus-visible:ring-offset-[#020202]"
          >
            <div class="lg:col-span-7 overflow-hidden rounded-2xl border border-white/[0.09] bg-[#09090d] aspect-[16/9]">
              <img
                src={featuredPost.data.coverImage}
                alt={featuredPost.data.coverAlt}
                width="1280"
                height="720"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.025] motion-reduce:transform-none"
              />
            </div>

            <div class="lg:col-span-5 flex flex-col justify-center">
              <div class="flex flex-wrap items-center gap-2.5 text-sm text-zinc-400 mb-4 tabular-nums">
                <span class="text-amber-400 font-medium">{featuredPost.data.section}</span>
                <span aria-hidden="true" class="text-zinc-600">·</span>
                <span>{featuredPost.data.readingTime}</span>
                <span aria-hidden="true" class="text-zinc-600">·</span>
                <time datetime={featuredPost.data.publishedAt.toISOString()}>
                  {formatDate(featuredPost.data.publishedAt)}
                </time>
              </div>

              <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.025em] text-white group-hover:text-amber-300 transition-colors duration-200 leading-[1.18] text-balance">
                {featuredPost.data.title}
              </h2>

              <p class="mt-4 text-base text-zinc-300 leading-relaxed">
                {featuredPost.data.description}
              </p>

              <div class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-white group-hover:text-amber-300 transition-colors duration-200">
                <span>Ler artigo completo</span>
                <svg
                  class="w-4 h-4 transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transform-none"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>
        </section>
      )}

      <section aria-label="Todos os artigos">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 mb-10 border-b border-white/[0.08]">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.02em] text-white">
              Artigos por seção
            </h2>
            <p class="mt-1.5 text-sm sm:text-base text-zinc-400">
              Escolha o tema que resolve a sua dúvida agora ou navegue por todos os guias publicados.
            </p>
          </div>

          <div
            id="section-filters"
            class="flex flex-wrap items-center gap-2"
            role="tablist"
            aria-label="Filtrar artigos por seção"
          >
            {sections.map((section, idx) => {
              const count =
                section === 'Todos'
                  ? allPosts.length
                  : allPosts.filter((p) => p.data.section === section).length;
              return (
                <button
                  type="button"
                  role="tab"
                  aria-selected={idx === 0 ? 'true' : 'false'}
                  data-filter={section}
                  class={`filter-btn min-h-[42px] px-4 py-2 rounded-full text-sm font-medium transition-colors duration-150 tabular-nums focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#020202] ${
                    idx === 0
                      ? 'bg-white text-black'
                      : 'bg-white/[0.04] text-zinc-300 hover:bg-white/[0.1] hover:text-white border border-white/[0.09]'
                  }`}
                >
                  {section}
                  <span class="ml-1.5 text-xs opacity-70">{count}</span>
                </button>
              );
            })}
          </div>
        </div>

        <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-12">
          {allPosts.map((post) => (
            <article
              data-section={post.data.section}
              class="post-card group flex flex-col"
            >
              <a
                href={`/blog/${post.id}`}
                class="flex flex-col h-full rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/80 focus-visible:ring-offset-4 focus-visible:ring-offset-[#020202]"
              >
                <div class="overflow-hidden rounded-xl border border-white/[0.08] bg-[#09090d] aspect-[16/9] mb-5">
                  <img
                    src={post.data.coverImage}
                    alt={post.data.coverAlt}
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transform-none"
                  />
                </div>

                <div class="flex items-center gap-2.5 text-sm text-zinc-400 mb-3 tabular-nums">
                  <span class="text-amber-400 font-medium">{post.data.section}</span>
                  <span aria-hidden="true" class="text-zinc-600">·</span>
                  <span>{post.data.readingTime}</span>
                  <span aria-hidden="true" class="text-zinc-600">·</span>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatDate(post.data.publishedAt)}
                  </time>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold tracking-[-0.02em] text-white group-hover:text-amber-300 transition-colors duration-200 leading-snug mb-2.5">
                  {post.data.title}
                </h3>

                <p class="text-base text-zinc-300 leading-relaxed flex-1">
                  {post.data.description}
                </p>

                <div class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-200 group-hover:text-amber-300 transition-colors duration-200">
                  <span>Ler artigo</span>
                  <svg
                    class="w-4 h-4 transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transform-none"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </a>
            </article>
          ))}
        </div>

        <div
          id="empty-filter-state"
          class="hidden py-16 px-6 text-center rounded-2xl bg-[#08080c] border border-white/[0.08]"
        >
          <p class="text-lg font-semibold text-white mb-2">
            Novos guias desta seção entram no ar nos próximos dias.
          </p>
          <p class="text-base text-zinc-400 max-w-md mx-auto">
            Enquanto isso, você pode ler os artigos já publicados ou falar direto com o Osmar sobre o seu segmento.
          </p>
          <button
            type="button"
            id="reset-filter-btn"
            class="mt-6 min-h-[44px] px-6 py-2.5 rounded-full text-sm font-semibold bg-white text-black hover:bg-zinc-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/80"
          >
            Ver todos os artigos publicados
          </button>
        </div>
      </section>

      <section
        aria-label="Implantação prática com a MOB"
        class="mt-24 pt-14 border-t border-white/[0.08]"
      >
        <div class="p-8 sm:p-12 rounded-2xl bg-[#08080c] border border-white/[0.09] grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.025em] text-white leading-tight text-balance">
              Quer tirar a IA do papel na sua empresa sem montar equipe de TI?
            </h2>
            <p class="mt-4 text-base text-zinc-300 leading-relaxed max-w-[60ch]">
              Com o <strong class="text-white">MOB Start</strong>, configuramos sua nuvem privada dedicada com tabelas, propostas e regras comerciais em até 72 horas — com treinamento ao vivo para toda a equipe em qualquer cidade do Brasil.
            </p>
          </div>

          <div class="lg:col-span-4 flex flex-col gap-3">
            <a
              href="https://wa.me/5547988131910?text=Ol%C3%A1%20Osmar!%20Estava%20lendo%20o%20blog%20da%20MOB%20e%20quero%20entender%20como%20implantar%20o%20MOB%20Start%20na%20minha%20empresa."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 min-h-[48px] rounded-full text-sm font-semibold bg-amber-400 text-black hover:bg-amber-300 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#08080c]"
            >
              <span>Agendar demonstração de 15 min</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/#precos"
              class="inline-flex items-center justify-center px-6 py-3.5 min-h-[48px] rounded-full text-sm font-medium text-zinc-200 hover:text-white bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
            >
              Ver planos e calculadora de retorno
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script is:inline>
    (function initBlogFilters() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.post-card');
      const emptyState = document.getElementById('empty-filter-state');
      const resetBtn = document.getElementById('reset-filter-btn');

      if (!buttons.length || !cards.length) return;

      const activeClass =
        'filter-btn min-h-[42px] px-4 py-2 rounded-full text-sm font-medium transition-colors duration-150 tabular-nums focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#020202] bg-white text-black';
      const inactiveClass =
        'filter-btn min-h-[42px] px-4 py-2 rounded-full text-sm font-medium transition-colors duration-150 tabular-nums focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#020202] bg-white/[0.04] text-zinc-300 hover:bg-white/[0.1] hover:text-white border border-white/[0.09]';

      const applyFilter = (selected) => {
        let visibleCount = 0;

        buttons.forEach((btn) => {
          const isSelected = btn.getAttribute('data-filter') === selected;
          btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          btn.className = isSelected ? activeClass : inactiveClass;
        });

        cards.forEach((card) => {
          const cardSection = card.getAttribute('data-section');
          const matches = selected === 'Todos' || cardSection === selected;
          card.classList.toggle('hidden', !matches);
          if (matches) visibleCount++;
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-filter') || 'Todos');
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => applyFilter('Todos'));
      }
    })();
  </script>
</Layout>
