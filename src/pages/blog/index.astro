---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const featuredPost = allPosts.find((post) => post.data.featured) ?? allPosts[0];

const otherPosts = allPosts.filter((post) => post.id !== featuredPost?.id);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date);

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog MOB | Inteligência Artificial para Empresas',
  description:
    'Guias práticos e diretos para donos de PMEs implementarem Inteligência Artificial na operação com retorno real e segurança LGPD.',
  url: 'https://mob.tec.br/blog',
  publisher: {
    '@type': 'Organization',
    name: 'MOB | Inteligência Artificial para Empresas',
    url: 'https://mob.tec.br',
  },
};
---

<Layout
  title="Blog da MOB | Guias de implantação de IA para empresas"
  description="Artigos práticos para donos e gestores de PMEs em todo o Brasil: como implementar IA, evitar erros comuns, calcular o retorno e proteger dados na LGPD."
  ogImage={featuredPost?.data.coverImage}
  jsonLd={blogSchema}
>
  <Navbar currentPage="blog" />

  <main class="bg-[#050507] text-white pt-32 pb-24 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <header class="pb-12 mb-14 border-b border-white/[0.08]">
        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-bold tracking-[-0.03em] text-white leading-[1.08] text-balance max-w-4xl">
          Por onde começar com IA na sua empresa?
        </h1>
        <p class="mt-5 text-base sm:text-lg text-zinc-300 leading-relaxed max-w-[62ch]">
          Escolha uma tarefa, entenda os custos e descubra como testar a mudança com quem faz o trabalho.
        </p>
      </header>

      <div class="grid lg:grid-cols-[1fr_1fr] gap-12 lg:gap-20 items-start">
        {featuredPost && (
          <section aria-label="Guia em destaque" class="bg-stone-100 text-stone-950 rounded-2xl p-7 sm:p-10">
            <span class="text-sm text-stone-600">{featuredPost.data.section}</span>
            <h2 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight leading-tight">
              <a href={'/blog/' + featuredPost.id + '/'} class="hover:underline underline-offset-4">{featuredPost.data.title}</a>
            </h2>
            <p class="mt-4 text-stone-700 leading-relaxed">{featuredPost.data.description}</p>
            <a href={'/blog/' + featuredPost.id + '/'} class="inline-block mt-8 font-semibold underline underline-offset-4">Ler o guia de implantação</a>
          </section>
        )}
        {otherPosts.length > 0 && (
          <section aria-label="Mais artigos">
            <h2 class="text-xl font-semibold mb-2">Mais guias para sua empresa</h2>
            <ul class="divide-y divide-white/15">
              {otherPosts.map((post) => (
                <li class="py-5">
                  <span class="text-sm text-zinc-400">{post.data.section} · <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time></span>
                  <h3 class="mt-1 text-xl font-medium leading-snug">
                    <a href={'/blog/' + post.id + '/'} class="hover:text-amber-300 focus-visible:underline">{post.data.title}</a>
                  </h3>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <section
        aria-label="Implantação prática com a MOB"
        class="mt-24 pt-14 border-t border-white/[0.08]"
      >
        <div class="p-8 sm:p-12 rounded-2xl bg-[#14161f] border border-white/[0.14] shadow-[inset_0_1px_0_rgba(255,255,255,0.06),0_18px_40px_-20px_rgba(0,0,0,0.85)] grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-[-0.025em] text-white leading-tight text-balance">
              Já pensou em uma tarefa para testar?
            </h2>
            <p class="mt-4 text-base text-zinc-300 leading-relaxed max-w-[60ch]">
              Conte ao Osmar como sua equipe trabalha hoje. Vamos avaliar o esforço, os dados disponíveis e como medir se uma primeira implantação vale a pena.
            </p>
          </div>

          <div class="lg:col-span-4 flex flex-col gap-3">
            <a
              href="https://wa.me/5547988131910?text=Ol%C3%A1%2C%20Osmar%21%20Li%20o%20blog%20da%20MOB%20e%20queria%20avaliar%20uma%20tarefa%20da%20minha%20empresa."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 min-h-[48px] rounded-full text-sm font-semibold bg-amber-400 text-black hover:bg-amber-300 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#08080c]"
            >
              <span>Contar minha rotina no WhatsApp</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/#como-funciona"
              class="inline-flex items-center justify-center px-6 py-3.5 min-h-[48px] rounded-full text-sm font-medium text-zinc-200 hover:text-white bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
            >
              Conhecer a implantação da MOB
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />

</Layout>
