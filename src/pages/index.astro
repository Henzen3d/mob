  <script is:inline>
    (function initRoiCalculator() {
      const sliderQuotes = document.getElementById('slider-quotes');
      const sliderMinutes = document.getElementById('slider-minutes');
      const sliderRate = document.getElementById('slider-rate');

      const labelQuotes = document.getElementById('label-quotes');
      const labelMinutes = document.getElementById('label-minutes');
      const labelRate = document.getElementById('label-rate');

      const statHours = document.getElementById('stat-hours');
      const statMoney = document.getElementById('stat-money');
      const statNet = document.getElementById('stat-net');
      const statSummary = document.getElementById('stat-summary');
      const whatsappLink = document.getElementById('roi-whatsapp-link');

      if (!sliderQuotes || !sliderMinutes || !sliderRate) return;

      const formatBRL = (val) => {
        return new Intl.NumberFormat('pt-BR', {
          style: 'currency',
          currency: 'BRL',
          maximumFractionDigits: 0,
        }).format(val);
      };

      function updateCalculation() {
        const quotes = parseInt(sliderQuotes.value, 10);
        const minutes = parseInt(sliderMinutes.value, 10);
        const rate = parseInt(sliderRate.value, 10);

        labelQuotes.textContent = `${quotes} / mês`;
        labelMinutes.textContent = `${minutes} minutos`;
        labelRate.textContent = `R$ ${rate} / hora`;

        const totalHoursPerMonth = (quotes * minutes) / 60;
        const hoursSaved = Math.max(1, Math.round(totalHoursPerMonth * 0.75));
        const grossSavings = Math.round(hoursSaved * rate);
        const monthlyFee = 990;
        const netSavings = grossSavings - monthlyFee;

        statHours.textContent = hoursSaved;
        statMoney.textContent = formatBRL(grossSavings);

        if (netSavings >= 0) {
          statNet.className = 'text-xl sm:text-2xl font-bold font-mono text-emerald-300';
          statNet.textContent = `+ ${formatBRL(netSavings)} / mês de retorno líquido`;
        } else {
          statNet.className = 'text-xl sm:text-2xl font-bold font-mono text-amber-300';
          statNet.textContent = `${formatBRL(netSavings)} / mês frente ao custo base`;
        }

        const daysToBreakeven = grossSavings > 0
          ? Math.min(30, Math.max(1, Math.round(monthlyFee / (grossSavings / 30))))
          : 30;

        statSummary.textContent = netSavings >= 0
          ? `A economia gerada cobre a mensalidade em aproximadamente ${daysToBreakeven} dias de operação comercial.`
          : 'Cenário inicial com baixo volume; ganho principal em agilidade de resposta ao cliente.';

        const message = `Olá! Fiz uma simulação na calculadora de ROI do site (${quotes} propostas/mês, ${minutes}min cada a R$ ${rate}/h) gerando economia estimada de ${hoursSaved}h/mês e gostaria de agendar uma demonstração.`;
        whatsappLink.href = `https://wa.me/5547988131910?text=${encodeURIComponent(message)}`;
      }

      sliderQuotes.addEventListener('input', updateCalculation);
      sliderMinutes.addEventListener('input', updateCalculation);
      sliderRate.addEventListener('input', updateCalculation);

      updateCalculation();
    })();
  </script>

  <script is:inline>
    (function initTimeline() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const el = document.getElementById('timeline-progress');
      if (!el) return;
      const section = document.querySelector('#como-funciona');
      if (!section) return;
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            el.style.transform = 'scaleX(1)';
            obs.disconnect();
          }
        });
      }, { threshold: 0.35 });
      obs.observe(section);
    })();
  </script>
