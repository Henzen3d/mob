---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AuroraHero from '../components/AuroraHero.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="MOB | Inteligência Artificial para Empresas"
  description="Servidor físico próprio de IA no seu escritório, sem mensalidade em dólar por usuário e com total sigilo dos dados. Conheça a MOB Box e o MOB CORE."
>
  <Navbar currentPage="home" />

  <main>
    <!-- 1. HERO SECTION WITH LIVING AURORA RAYS -->
    <AuroraHero />

    <!-- ------------------------------------------------------------- -->
    <!-- 2. OS 3 PILARES PRÁTICOS DA MOB (Double-Bezel Bento Grid)     -->
    <!-- ------------------------------------------------------------- -->
    <section id="como-funciona" class="relative py-28 px-4 max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-mono font-semibold uppercase tracking-widest text-amber-400 bg-amber-400/10 border border-amber-400/20 px-3 py-1 rounded-full">
          ARQUITETURA PRÁTICA
        </span>
        <h2 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
          Chega de teoria sobre IA.<br />Veja o que funciona na sua empresa:
        </h2>
        <p class="mt-4 text-gray-400 text-base md:text-lg">
          Zero jargões ou fórmulas acadêmicas. Criamos uma solução pronta para resolver os gargalos reais do seu escritório no primeiro dia.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Pilar 1: MOB Box -->
        <div class="relative p-1.5 rounded-[2rem] bg-gradient-to-b from-white/10 to-white/[0.02] border border-white/10 shadow-[0_10px_30px_rgba(0,0,0,0.5)] group hover:border-amber-400/40 transition-all">
          <div class="h-full rounded-[calc(2rem-0.375rem)] bg-[#08080c] p-7 flex flex-col justify-between border border-white/5">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-6 group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(245,158,11,0.2)]">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                </svg>
              </div>
              <span class="text-xs font-mono text-amber-400 font-semibold">PILAR 01</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-3">A MOB Box no Escritório</h3>
              <p class="text-sm text-gray-400 leading-relaxed">
                Um computador silencioso e compacto que fica dentro da sua empresa. Seus contratos, tabelas e dados confidenciais são armazenados localmente, sem riscos de vazamento para inteligências públicas.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-mono text-gray-400">
              <span>Hardware Físico</span>
              <span class="text-emerald-400 font-semibold">100% Protegido</span>
            </div>
          </div>
        </div>

        <!-- Pilar 2: Assistentes com Suas Regras -->
        <div class="relative p-1.5 rounded-[2rem] bg-gradient-to-b from-white/10 to-white/[0.02] border border-white/10 shadow-[0_10px_30px_rgba(0,0,0,0.5)] group hover:border-amber-400/40 transition-all">
          <div class="h-full rounded-[calc(2rem-0.375rem)] bg-[#08080c] p-7 flex flex-col justify-between border border-white/5">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-6 group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(245,158,11,0.2)]">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <span class="text-xs font-mono text-amber-400 font-semibold">PILAR 02</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-3">Assistentes Treinados</h3>
              <p class="text-sm text-gray-400 leading-relaxed">
                Três assistentes de fábrica calibrados com as diretrizes do seu negócio: o <strong>Consultor Interno</strong> (tabelas e manuais), o <strong>Redator de Padrão</strong> (áudios virando orçamentos) e o <strong>Analista de Documentos</strong>.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-mono text-gray-400">
              <span>3 Modelos Prontos</span>
              <span class="text-amber-400 font-semibold">Cita Fontes</span>
            </div>
          </div>
        </div>

        <!-- Pilar 3: Automação & Treinamento -->
        <div class="relative p-1.5 rounded-[2rem] bg-gradient-to-b from-white/10 to-white/[0.02] border border-white/10 shadow-[0_10px_30px_rgba(0,0,0,0.5)] group hover:border-amber-400/40 transition-all">
          <div class="h-full rounded-[calc(2rem-0.375rem)] bg-[#08080c] p-7 flex flex-col justify-between border border-white/5">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-6 group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(245,158,11,0.2)]">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
              </div>
              <span class="text-xs font-mono text-amber-400 font-semibold">PILAR 03</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-3">Treinamento Presencial</h3>
              <p class="text-sm text-gray-400 leading-relaxed">
                Não exigimos que sua equipe entenda de tecnologia. Para alimentar a IA, basta arrastar arquivos numa pasta da rede do Windows. Nós vamos até sua empresa e ensinamos todo mundo a usar na prática.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-mono text-gray-400">
              <span>Metodologia</span>
              <span class="text-amber-400 font-semibold">Mão na Massa</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- -->
    <!-- 3. COMO FUNCIONA EM 3 PASSOS (Fácil Assim)                    -->
    <!-- ------------------------------------------------------------- -->
    <section class="relative py-20 px-4 bg-[#050508] border-y border-white/5">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-mono font-semibold uppercase tracking-widest text-amber-400">
            SIMPLICIDADE DE ADOÇÃO
          </span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Como funciona a implantação na sua empresa
          </h2>
          <p class="mt-3 text-gray-400 text-sm md:text-base">
            Sem obras, sem reformulação de sistemas e sem parar o trabalho da sua equipe.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
          <!-- Step 1 -->
          <div class="flex flex-col items-start p-6 rounded-3xl bg-white/[0.02] border border-white/5 relative">
            <div class="text-3xl font-black font-mono text-amber-400/40 mb-4">01</div>
            <h3 class="text-lg font-bold text-white mb-2">Instalamos a MOB Box</h3>
            <p class="text-sm text-gray-400 leading-relaxed">
              Levamos a caixa até seu escritório, conectamos na tomada e na rede local. Nenhuma porta é aberta para a internet pública.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="flex flex-col items-start p-6 rounded-3xl bg-white/[0.02] border border-white/5 relative">
            <div class="text-3xl font-black font-mono text-amber-400/40 mb-4">02</div>
            <h3 class="text-lg font-bold text-white mb-2">Alimentamos o Cérebro</h3>
            <p class="text-sm text-gray-400 leading-relaxed">
              Carregamos suas tabelas de preços, manuais de procedimento e modelos de proposta. A IA aprende as regras da sua empresa.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="flex flex-col items-start p-6 rounded-3xl bg-white/[0.02] border border-white/5 relative">
            <div class="text-3xl font-black font-mono text-amber-400/40 mb-4">03</div>
            <h3 class="text-lg font-bold text-white mb-2">Sua Equipe Poupa Horas</h3>
            <p class="text-sm text-gray-400 leading-relaxed">
              Vendedores mandam áudios e recebem orçamentos prontos em PDF. Respostas a dúvidas operacionais saem em segundos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- -->
    <!-- 4. A LINHA MOB BOX (Hardware Showcase & Maleta Demo)          -->
    <!-- ------------------------------------------------------------- -->
    <section id="mob-box" class="relative py-28 px-4 max-w-6xl mx-auto">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-12 mb-16">
        <div class="max-w-xl text-left">
          <span class="text-xs font-mono font-semibold uppercase tracking-widest text-amber-400 bg-amber-400/10 border border-amber-400/20 px-3 py-1 rounded-full">
            HARDWARE DEDICADO
          </span>
          <h2 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
            A MOB Box: Silenciosa, potente e segura.
          </h2>
          <p class="mt-4 text-gray-400 text-base leading-relaxed">
            Desenvolvida para operar 24 horas por dia dentro de escritórios. Com ajuste de religamento autônomo após queda de energia (*Restore on AC Power Loss*), nobreak homologado e consumo elétrico de apenas R$ 12 por mês.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent border border-amber-500/20 max-w-md text-left">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">💼</span>
            <h3 class="text-base font-bold text-white">A Maleta de Demonstração (15 min)</h3>
          </div>
          <p class="text-xs text-gray-300 leading-relaxed mb-4">
            Não pedimos sua senha de Wi-Fi. Nosso consultor chega com a maleta autônoma, liga na tomada e demonstra com um áudio ou arquivo real da sua empresa funcionando na hora.
          </p>
          <a
            href="https://wa.me/5547999999999?text=Ol%C3%A1%20Osmar!%20Gostaria%20de%20receber%20a%20Maleta%20de%20Demonstra%C3%A7%C3%A3o%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
            target="_blank"
            class="inline-flex items-center gap-2 text-xs font-bold text-amber-300 hover:text-amber-200 transition-colors"
          >
            <span>Solicitar demonstração presencial</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Models Bento -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Compact -->
        <div class="p-6 rounded-3xl bg-[#090a0f] border border-white/10 hover:border-amber-400/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-amber-400">MOB BOX COMPACT</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/10 text-gray-300">Entrada / Híbrida</span>
            </div>
            <h4 class="text-lg font-bold text-white mb-2">Ideal para 90% das PMEs</h4>
            <p class="text-xs text-gray-400 leading-relaxed mb-6">
              Documentos locais, busca vetorial interna e inferência rápida via API privada com Zero Data Retention.
            </p>
            <ul class="space-y-2 text-xs text-gray-300 font-mono">
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Mini PC Intel N100 / Ryzen 5</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> 16GB RAM + 512GB SSD NVMe</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Nobreak compacto incluso</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Consumo elétrico de ~15W</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-white/5 text-xs text-gray-400">
            Recomendado para orçamentos e rotinas de escritório.
          </div>
        </div>

        <!-- Pro -->
        <div class="p-6 rounded-3xl bg-[#090a0f] border-2 border-amber-500/40 shadow-[0_0_30px_rgba(245,158,11,0.15)] flex flex-col justify-between relative">
          <div class="absolute -top-3 right-6 px-3 py-0.5 rounded-full bg-amber-500 text-black text-[10px] font-bold tracking-wider uppercase font-mono">
            100% LOCAL SILENCIOSA
          </div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-amber-400">MOB BOX PRO</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300">Advocacia & Sigilo</span>
            </div>
            <h4 class="text-lg font-bold text-white mb-2">Para Sigilo e Conformidade Rigorosa</h4>
            <p class="text-xs text-gray-400 leading-relaxed mb-6">
              Modelos de linguagem rodando 100% dentro do hardware físico local. Nenhum byte cruza as paredes da empresa.
            </p>
            <ul class="space-y-2 text-xs text-gray-300 font-mono">
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Mac Mini M4 24GB ou Workstation RTX</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Operação 100% desconectada da nuvem</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Silêncio absoluto (&lt; 18dB)</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Leitura profunda de contratos e laudos</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-white/5">
            <a href="/advocacia" class="text-xs font-bold text-amber-300 hover:text-amber-200 flex items-center justify-between">
              <span>Conhecer solução para Advocacia</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Ultra -->
        <div class="p-6 rounded-3xl bg-[#090a0f] border border-white/10 hover:border-amber-400/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-amber-400">MOB BOX ULTRA</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/10 text-gray-300">Alta Densidade</span>
            </div>
            <h4 class="text-lg font-bold text-white mb-2">Workstation Multi-GPU</h4>
            <p class="text-xs text-gray-400 leading-relaxed mb-6">
              Para empresas com alta concorrência simultânea e múltiplos fluxos de automação pesada em paralelo.
            </p>
            <ul class="space-y-2 text-xs text-gray-300 font-mono">
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> GPUs dedicadas de 24GB a 48GB VRAM</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Modelos de 32B a 70B parâmetros</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Suporte a 25+ usuários concorrentes</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Projeto sob consulta personalizada</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-white/5 text-xs text-gray-400">
            Fornecimento estritamente sob encomenda.
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- -->
    <!-- 5. COMPARATIVO DE MERCADO (Zylon-Style Matrix)                -->
    <!-- ------------------------------------------------------------- -->
    <section id="comparativo" class="relative py-28 px-4 bg-[#050508] border-y border-white/5">
      <div class="max-w-5xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-mono font-semibold uppercase tracking-widest text-amber-400">
            POR QUE ESCOLHER A MOB
          </span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Comparativo de Soluções de IA no Mercado
          </h2>
          <p class="mt-3 text-gray-400 text-sm md:text-base">
            Veja a diferença entre instalar uma infraestrutura própria e assinar ferramentas genéricas em dólar.
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse min-w-[640px]">
            <thead>
              <tr class="border-b border-white/10 text-xs font-mono text-gray-400 uppercase">
                <th class="py-4 px-4 font-semibold">Critério de Avaliação</th>
                <th class="py-4 px-4 font-bold text-amber-400 bg-amber-500/5 rounded-t-2xl">MOB Box / MOB IA</th>
                <th class="py-4 px-4 font-semibold">ChatGPT Team (em Dólar)</th>
                <th class="py-4 px-4 font-semibold">Consultorias Tradicionais</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-gray-300">
              <tr>
                <td class="py-4 px-4 font-medium text-white">Onde os dados ficam guardados?</td>
                <td class="py-4 px-4 bg-amber-500/5 text-amber-300 font-semibold">No seu escritório ou ZDR</td>
                <td class="py-4 px-4 text-gray-400">Nuvem pública nos EUA</td>
                <td class="py-4 px-4 text-gray-400">Nuvens complexas de terceiros</td>
              </tr>
              <tr>
                <td class="py-4 px-4 font-medium text-white">Modelo de Cobrança</td>
                <td class="py-4 px-4 bg-amber-500/5 text-amber-300 font-semibold">Fixo em Reais (Sem sustos)</td>
                <td class="py-4 px-4 text-gray-400">US$ 30 por usuário + IOF</td>
                <td class="py-4 px-4 text-gray-400">R$ 15.000 a R$ 50.000/mês</td>
              </tr>
              <tr>
                <td class="py-4 px-4 font-medium text-white">Alimentação da Inteligência</td>
                <td class="py-4 px-4 bg-amber-500/5 text-amber-300 font-semibold">Pasta do Windows Explorer</td>
                <td class="py-4 px-4 text-gray-400">Upload manual tela a tela</td>
                <td class="py-4 px-4 text-gray-400">Scripts complexos</td>
              </tr>
              <tr>
                <td class="py-4 px-4 font-medium text-white">Treinamento da Equipe</td>
                <td class="py-4 px-4 bg-amber-500/5 text-amber-300 font-semibold">Presencial, na mesa do cliente</td>
                <td class="py-4 px-4 text-gray-400">Nenhum treinamento</td>
                <td class="py-4 px-4 text-gray-400">Palestras teóricas</td>
              </tr>
              <tr>
                <td class="py-4 px-4 font-medium text-white">Suporte Técnico</td>
                <td class="py-4 px-4 bg-amber-500/5 text-amber-300 font-semibold">Local em Blumenau e Vale</td>
                <td class="py-4 px-4 text-gray-400">Fóruns em inglês</td>
                <td class="py-4 px-4 text-gray-400">Tickets impessoais</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- -->
    <!-- 6. TABELA OFICIAL DE PREÇOS & CALCULADORA DE ROI              -->
    <!-- ------------------------------------------------------------- -->
    <section id="precos" class="relative py-28 px-4 max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-mono font-semibold uppercase tracking-widest text-amber-400 bg-amber-400/10 border border-amber-400/20 px-3 py-1 rounded-full">
          INVESTIMENTO TRANSPARENTE
        </span>
        <h2 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
          Preços em Reais, Sem Surpresas
        </h2>
        <p class="mt-4 text-gray-400 text-base">
          Escolha entre a compra definitiva do equipamento ou o modelo de assinatura com comodato.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        <!-- Card 1: MOB Start -->
        <div class="p-8 rounded-[2rem] bg-[#08080c] border border-white/10 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-gray-400 uppercase font-semibold">Nuvem Privada</span>
            <h3 class="text-2xl font-bold text-white mt-1">MOB Start</h3>
            <p class="text-xs text-gray-400 mt-2 mb-6">Para empresas que querem começar rápido sem comprar hardware físico inicial.</p>
            
            <div class="mb-6">
              <span class="text-3xl font-extrabold text-white">R$ 4.900</span>
              <span class="text-xs text-gray-400"> setup único</span>
              <div class="text-sm font-semibold text-amber-400 mt-1">+ R$ 990 / mês</div>
            </div>

            <ul class="space-y-3 text-xs text-gray-300 font-mono mb-8">
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> 1 Fluxo prioritário implantado</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Até 50 documentos da empresa</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> 3 Assistentes de fábrica</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Treinamento prático da equipe</li>
              <li class="flex items-center gap-2"><span class="text-amber-400">✓</span> Implantação em até 15 dias</li>
            </ul>
          </div>

          <a
