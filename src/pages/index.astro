  <script is:inline>
    (function initRoiCalculator() {
      const sliderQuotes = document.getElementById('slider-quotes');
      const sliderMinutes = document.getElementById('slider-minutes');
      const sliderRate = document.getElementById('slider-rate');

      const labelQuotes = document.getElementById('label-quotes');
      const labelMinutes = document.getElementById('label-minutes');
      const labelRate = document.getElementById('label-rate');

      const statHours = document.getElementById('stat-hours');
      const statMoney = document.getElementById('stat-money');
      const statNet = document.getElementById('stat-net');
      const whatsappLink = document.getElementById('roi-whatsapp-link');

      if (!sliderQuotes || !sliderMinutes || !sliderRate) return;

      const formatBRL = (val) => {
        return new Intl.NumberFormat('pt-BR', {
          style: 'currency',
          currency: 'BRL',
          maximumFractionDigits: 0,
        }).format(val);
      };

      function updateCalculation() {
        const quotes = parseInt(sliderQuotes.value, 10);
        const minutes = parseInt(sliderMinutes.value, 10);
        const rate = parseInt(sliderRate.value, 10);

        labelQuotes.textContent = `${quotes} / mês`;
        labelMinutes.textContent = `${minutes} minutos`;
        labelRate.textContent = `R$ ${rate} / hora`;

        const hoursSaved = (quotes * minutes) / 60;
        const grossSavings = Math.round(hoursSaved * rate);
        const monthlyFee = 990;
        const netSavings = grossSavings - monthlyFee;

        const hoursLabel = hoursSaved.toLocaleString('pt-BR', { maximumFractionDigits: 1 });
        statHours.textContent = hoursLabel;
        statMoney.textContent = formatBRL(grossSavings);

        if (netSavings >= 0) {
          statNet.className = 'text-xl sm:text-2xl font-bold font-mono text-emerald-300 tabular-nums';
          statNet.textContent = `+ ${formatBRL(netSavings)} / mês`;
        } else {
          statNet.className = 'text-xl sm:text-2xl font-bold font-mono text-amber-300 tabular-nums';
          statNet.textContent = `${formatBRL(netSavings)} / mês`;
        }

        const message = `Olá, Osmar! Simulei uma tarefa com ${quotes} execuções/mês e uma possível redução de ${minutes} minutos por execução (${hoursLabel} h/mês). Quero avaliar essa hipótese.`;
        whatsappLink.href = `https://wa.me/5547988131910?text=${encodeURIComponent(message)}`;
      }

      sliderQuotes.addEventListener('input', updateCalculation);
      sliderMinutes.addEventListener('input', updateCalculation);
      sliderRate.addEventListener('input', updateCalculation);

      updateCalculation();
    })();
  </script>

