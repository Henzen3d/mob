---
// AuroraHero.astro - Zylon-inspired Cosmic Horizon with Procedural Aurora Rays
---

<section class="relative min-h-[90dvh] flex flex-col items-center justify-center pt-32 pb-24 px-4 overflow-hidden">
  <!-- ------------------------------------------------------------- -->
  <!-- 1. DYNAMIC MOVING AURORA RAYS (Procedural Canvas + Horizon)   -->
  <!-- ------------------------------------------------------------- -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
    <!-- Deep pitch black base -->
    <div class="absolute inset-0 bg-[#020202]"></div>
    <div class="absolute inset-0 bg-noise opacity-30"></div>

    <!-- Live Canvas Aurora Rays (60fps procedural shimmer) -->
    <canvas id="aurora-canvas" class="absolute inset-0 w-full h-full opacity-65 mix-blend-screen"></canvas>

    <!-- Celestial Horizon Atmospheric Glows -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1100px] h-[500px] bg-gradient-to-b from-amber-500/15 via-orange-600/10 to-transparent rounded-full blur-[120px]"></div>
    <div class="absolute top-10 left-1/3 -translate-x-1/2 w-[700px] h-[400px] bg-gradient-to-br from-amber-400/10 via-yellow-600/5 to-transparent rounded-full blur-[90px]"></div>
    <div class="absolute top-12 right-1/4 w-[650px] h-[400px] bg-gradient-to-bl from-blue-600/15 via-cyan-500/10 to-transparent rounded-full blur-[100px]"></div>

    <!-- The Planetary Horizon Curvature Arc -->
    <div class="absolute top-[320px] md:top-[300px] left-1/2 -translate-x-1/2 w-[1400px] md:w-[2200px] h-[700px] md:h-[1000px] rounded-[100%] border-t border-amber-300/30 shadow-[0_-20px_70px_rgba(245,158,11,0.2)] pointer-events-none">
      <!-- Horizon Rim Bloom -->
      <div class="absolute inset-x-0 -top-4 h-8 bg-gradient-to-r from-transparent via-amber-400/35 to-transparent blur-md"></div>
      <div class="absolute inset-x-0 -top-1 h-2 bg-gradient-to-r from-transparent via-white/80 to-transparent blur-[1.5px]"></div>
    </div>
  </div>

  <!-- ------------------------------------------------------------- -->
  <!-- 2. HERO CONTENT LAYER (No AI Slop / Anti-Kicker / Pure Craft) -->
  <!-- ------------------------------------------------------------- -->
  <div class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center">
    
    <!-- Headline: Confident, Crisp, No Gradients, Editorial Scale -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-white leading-[1.08] text-balance">
      A Inteligência Artificial que assume a rotina pesada da sua empresa.
    </h1>

    <!-- Subtitle: Asaas Tone, Operational Relief, Zero Fluff -->
    <p class="mt-7 text-base sm:text-lg md:text-xl text-zinc-300 max-w-2xl font-normal leading-relaxed text-balance">
      Áudios do WhatsApp viram orçamentos detalhados em segundos, contratos são analisados na hora e assistentes respondem com a tabela de preços do seu negócio. Com a <strong class="text-white font-medium">MOB Box</strong>, seus dados não saem do seu escritório e você não paga mensalidade em dólar por funcionário.
    </p>

    <!-- CTAs: High Contrast, Tactile, Architectural -->
    <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
      <a
        href="https://wa.me/5547999999999?text=Ol%C3%A1!%20Acessei%20o%20site%20mob.tec.br%20e%20gostaria%20de%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20presencial%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full text-sm font-semibold bg-white text-black hover:bg-zinc-200 shadow-[0_0_30px_rgba(255,255,255,0.2)] transition-all active:scale-95"
      >
        <span>Agendar Demonstração de 15 Minutos</span>
        <svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <a
        href="#como-funciona"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-sm font-medium text-zinc-300 hover:text-white bg-white/[0.05] hover:bg-white/[0.08] border border-white/[0.08] backdrop-blur-xl transition-all"
      >
        <span>Ver Como Funciona</span>
        <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

    <!-- Micro Proof Line (Subtle Typography, No Cheesy Icons) -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-mono text-zinc-400">
      <span>• Demonstração presencial na sua mesa</span>
      <span>• Custo fixo sem surpresa no cartão</span>
      <span>• Dados isolados na rede local</span>
    </div>

    <!-- ------------------------------------------------------------- -->
    <!-- 3. APPLIANCE ARCHITECTURE CARD (Zylon Density & Precision)    -->
    <!-- ------------------------------------------------------------- -->
    <div class="mt-14 w-full max-w-4xl mx-auto">
      <div class="relative rounded-2xl bg-[#09090c] border border-white/[0.08] shadow-[0_20px_50px_rgba(0,0,0,0.8)] overflow-hidden">
        
        <!-- Top Precision Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-3.5 border-b border-white/[0.06] bg-white/[0.02] text-xs font-mono">
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-zinc-200 font-semibold tracking-wide">MOB BOX — APPLIANCE LOCAL ATIVA</span>
          </div>
          <div class="flex items-center gap-4 text-zinc-400 text-[11px]">
            <span>REDE: <strong class="text-zinc-200">\\mob-box\documentos-ia</strong></span>
            <span>LATÊNCIA: <strong class="text-emerald-400">&lt; 45ms</strong></span>
            <span class="text-zinc-500 hidden sm:inline">ZERO DATA RETENTION</span>
          </div>
        </div>

        <!-- 3 Pillars Workflow Simulation (Asymmetric & Dense) -->
        <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/[0.06] text-left">
          
          <!-- Column 1: Ingestão Invisível -->
          <div class="p-6">
            <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5">Entrada de Rotina</div>
            <h3 class="text-sm font-semibold text-white mb-2">Áudios & Documentos na Rede</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              O colaborador envia um áudio de 40s pelo WhatsApp ou arrasta planilhas e PDFs para a pasta da rede no Windows.
            </p>
            <div class="mt-4 px-3 py-2 rounded bg-black/60 border border-white/[0.06] text-[11px] font-mono text-zinc-300 flex items-center justify-between">
              <span>audio_reuniao_cliente.ogg</span>
              <span class="text-[10px] text-zinc-500">42s</span>
            </div>
          </div>

          <!-- Column 2: Cérebro Local -->
          <div class="p-6">
            <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5">Processamento Seguro</div>
            <h3 class="text-sm font-semibold text-white mb-2">Regras e Tabelas da Empresa</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              A IA cruza o pedido com a sua tabela de preços oficial dentro da MOB Box. Informações sigilosas jamais saem do escritório.
            </p>
            <div class="mt-4 px-3 py-2 rounded bg-black/60 border border-white/[0.06] text-[11px] font-mono text-zinc-300 flex items-center justify-between">
              <span>Tabela-Precos-2026.pdf</span>
              <span class="text-[10px] text-emerald-400">Cruzado</span>
            </div>
          </div>

          <!-- Column 3: Entrega Pronta -->
          <div class="p-6">
            <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-1.5">Resultado Final</div>
            <h3 class="text-sm font-semibold text-white mb-2">Orçamento Timbrado em 8s</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              PDF diagramado com peças calculadas, prazos e aviso legal de conferência humana pronto para envio ao cliente.
            </p>
            <div class="mt-4 px-3 py-2 rounded bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-mono text-emerald-300 flex items-center justify-between">
              <span>Orcamento-Formatado.pdf</span>
              <span class="text-[10px] font-bold text-emerald-400">PRONTO</span>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<!-- ------------------------------------------------------------- -->
<!-- 4. LIGHTWEIGHT 60FPS PROCEDURAL AURORA RAYS SCRIPT            -->
<!-- ------------------------------------------------------------- -->
<script>
  function initAuroraRays() {
    const canvas = document.getElementById('aurora-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    // Procedural light ray definition
    const numRays = 26;
    const rays: Array<{
      baseX: number;
      width: number;
      speed: number;
      phase: number;
      color: string;
      alpha: number;
    }> = [];

    const colors = [
      'rgba(245, 158, 11, ',  // Amber Gold
      'rgba(251, 191, 36, ',  // Warm Light Yellow
      'rgba(217, 119, 6, ',   // Deep Amber
      'rgba(1, 117, 255, ',   // Zylon Cyan/Blue
      'rgba(125, 164, 255, ', // Aurora Glow Blue
    ];

    for (let i = 0; i < numRays; i++) {
      rays.push({
        baseX: (width / numRays) * i + (Math.random() - 0.5) * 50,
        width: 35 + Math.random() * 75,
        speed: 0.0005 + Math.random() * 0.001,
        phase: Math.random() * Math.PI * 2,
        color: colors[i % colors.length],
        alpha: 0.12 + Math.random() * 0.28,
      });
    }

    let t = 0;
    function render() {
      t += 1;
      ctx.clearRect(0, 0, width, height);

      const horizonY = height * 0.44;

      for (let i = 0; i < rays.length; i++) {
        const ray = rays[i];
        const currentPhase = ray.phase + t * ray.speed;
        
        // Sway and wave calculation
        const sway = Math.sin(currentPhase) * 85;
        const topX = ray.baseX + sway + Math.cos(currentPhase * 0.5) * 45;
        const currentAlpha = ray.alpha * (0.6 + 0.4 * Math.sin(currentPhase * 1.4));

        const gradient = ctx.createLinearGradient(ray.baseX, horizonY, topX, 0);
        gradient.addColorStop(0, `${ray.color}0)`);
        gradient.addColorStop(0.2, `${ray.color}${currentAlpha * 0.7})`);
        gradient.addColorStop(0.65, `${ray.color}${currentAlpha * 0.35})`);
        gradient.addColorStop(1, `${ray.color}0)`);

        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.moveTo(ray.baseX - ray.width * 0.5, horizonY);
        ctx.lineTo(topX - ray.width * 1.7, 0);
        ctx.lineTo(topX + ray.width * 1.7, 0);
        ctx.lineTo(ray.baseX + ray.width * 0.5, horizonY);
        ctx.closePath();
        ctx.fill();
      }

      requestAnimationFrame(render);
    }

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuroraRays);
  } else {
    initAuroraRays();
  }
</script>
