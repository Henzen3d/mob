---
// AuroraHero.astro - Zylon-inspired Cosmic Aurora with Living Moving Light Rays
---

<section class="relative min-h-[92dvh] flex flex-col items-center justify-center pt-32 pb-20 px-4 overflow-hidden">
  <!-- ------------------------------------------------------------- -->
  <!-- 1. DYNAMIC MOVING AURORA RAYS ENGINE (Canvas + CSS Mesh)      -->
  <!-- ------------------------------------------------------------- -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
    <!-- Base dark background with noise -->
    <div class="absolute inset-0 bg-[#030303]"></div>
    <div class="absolute inset-0 bg-noise opacity-40"></div>

    <!-- Live Canvas Aurora Rays (60fps procedural shimmer) -->
    <canvas id="aurora-canvas" class="absolute inset-0 w-full h-full opacity-70 mix-blend-screen"></canvas>

    <!-- Layered Atmospheric Glow Filters (Multi-Color Aurora Spectrum) -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[1200px] h-[550px] bg-gradient-to-b from-amber-500/20 via-orange-600/15 to-transparent rounded-full blur-[100px] animate-pulse-glow"></div>
    <div class="absolute top-0 left-1/4 w-[600px] h-[450px] bg-gradient-to-br from-amber-400/15 via-yellow-600/10 to-transparent rounded-full blur-[90px] animate-aurora-slow"></div>
    <div class="absolute top-10 right-1/4 w-[700px] h-[450px] bg-gradient-to-bl from-blue-600/15 via-cyan-500/10 to-transparent rounded-full blur-[100px] animate-aurora-wave"></div>

    <!-- The Glowing Horizon Rim (Planetary Arc) -->
    <div class="absolute top-[280px] md:top-[260px] left-1/2 -translate-x-1/2 w-[1400px] md:w-[2200px] h-[600px] md:h-[900px] rounded-[100%] border-t border-amber-300/40 shadow-[0_-25px_80px_rgba(245,158,11,0.25)] pointer-events-none">
      <!-- Horizon light bloom -->
      <div class="absolute inset-x-0 -top-6 h-12 bg-gradient-to-r from-transparent via-amber-400/40 to-transparent blur-md"></div>
      <div class="absolute inset-x-0 -top-2 h-4 bg-gradient-to-r from-transparent via-white/70 to-transparent blur-[2px]"></div>
    </div>
  </div>

  <!-- ------------------------------------------------------------- -->
  <!-- 2. HERO CONTENT LAYER                                         -->
  <!-- ------------------------------------------------------------- -->
  <div class="relative z-10 max-w-5xl mx-auto text-center flex flex-col items-center">
    
    <!-- Micro Tag / Eyebrow Pill -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-xl mb-6 shadow-[0_0_20px_rgba(245,158,11,0.15)] animate-float-slow">
      <span class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_#f59e0b] animate-ping"></span>
      <span class="text-[11px] md:text-xs font-semibold tracking-wider uppercase text-amber-200/90 font-mono">
        BLUMENAU & VALE DO ITAJAÍ • IA PRÁTICA PARA EMPRESAS
      </span>
    </div>

    <!-- Main Headline (Editorial Impact) -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] max-w-4xl text-balance">
      A Inteligência Artificial que tira sua empresa do <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-500 drop-shadow-[0_0_30px_rgba(245,158,11,0.3)]">sufoco operacional</span>.
    </h1>

    <!-- Subtitle (Direct & Asaas Tone) -->
    <p class="mt-6 md:mt-8 text-base sm:text-lg md:text-xl text-gray-300/90 max-w-2xl font-normal leading-relaxed text-balance">
      Transformamos áudios do WhatsApp em orçamentos prontos em segundos, resumimos contratos e treinamos assistentes com as regras da sua empresa. Com a <strong class="text-white font-semibold">MOB Box</strong>, seus dados não saem do escritório e você não paga mensalidade em dólar por usuário.
    </p>

    <!-- CTAs and Social Proof Badges -->
    <div class="mt-8 md:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
      <!-- Primary CTA: WhatsApp -->
      <a
        href="https://wa.me/5547999999999?text=Ol%C3%A1!%20Acessei%20o%20site%20mob.tec.br%20e%20gostaria%20de%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20presencial%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
        target="_blank"
        rel="noopener noreferrer"
        class="group w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full text-sm font-bold bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 text-black hover:brightness-110 shadow-[0_0_35px_rgba(245,158,11,0.45)] transition-all active:scale-95"
      >
        <span>Agendar Demonstração de 15 Minutos</span>
        <div class="w-6 h-6 rounded-full bg-black/20 flex items-center justify-center transition-transform group-hover:translate-x-1">
          <svg class="w-3.5 h-3.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </div>
      </a>

      <!-- Secondary CTA: Como Funciona -->
      <a
        href="#como-funciona"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full text-sm font-medium text-gray-200 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 backdrop-blur-xl transition-all"
      >
        <span>Como Funciona</span>
        <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

    <!-- Trust Micro-Bullet Bar -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-gray-400 font-mono">
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Demonstração presencial na sua mesa
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Sem mensalidade em dólar por usuário
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Sigilo estrito e dados no seu escritório
      </span>
    </div>

    <!-- ------------------------------------------------------------- -->
    <!-- 3. HARDWARE & WORKFLOW PREVIEW (The Physical Appliance Card)  -->
    <!-- ------------------------------------------------------------- -->
    <div class="mt-14 w-full max-w-4xl mx-auto">
      <div class="relative p-2 rounded-[2.5rem] bg-gradient-to-b from-white/15 to-white/5 border border-white/10 backdrop-blur-2xl shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9)] group">
        <div class="relative rounded-[calc(2.5rem-0.5rem)] bg-[#09090d]/90 p-6 md:p-8 border border-white/5 overflow-hidden">
          
          <!-- Card Header / Status Indicators -->
          <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-white/10">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_10px_#10b981] animate-pulse"></div>
              <span class="text-xs font-mono text-gray-300 font-semibold tracking-wide">
                MOB BOX • APPLIANCE LOCAL ATIVA
              </span>
            </div>
            <div class="flex items-center gap-4 text-xs font-mono text-gray-400">
              <span class="hidden sm:inline">IP: <span class="text-amber-400 font-bold">mobbox.local</span></span>
              <span>LAN: <span class="text-emerald-400 font-bold">1000 Mbps</span></span>
              <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 text-[10px]">Zero Data Retention</span>
            </div>
          </div>

          <!-- Interactive Workflow Simulation Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 text-left">
            
            <!-- Step 1: Input -->
            <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-amber-400/30 transition-colors">
              <div class="flex items-center gap-2 mb-2 text-xs font-mono text-amber-400">
                <span>01. ENTRADA NA ROTINA</span>
              </div>
              <h3 class="text-sm font-bold text-white mb-1">Áudio ou Arquivo na Rede</h3>
              <p class="text-xs text-gray-400 leading-relaxed">
                Técnico ou vendedor grava áudio de 40s no WhatsApp ou arrasta um PDF para <code class="text-amber-300 text-[11px] bg-black/40 px-1 py-0.5 rounded">\\mob-box\documentos-ia</code>.
              </p>
              <div class="mt-3 p-2.5 rounded-lg bg-black/60 border border-white/10 text-[11px] font-mono text-gray-300 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                <span>audio_visita_cliente.ogg</span>
              </div>
            </div>

            <!-- Step 2: Processing -->
            <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-amber-400/30 transition-colors">
              <div class="flex items-center gap-2 mb-2 text-xs font-mono text-amber-400">
                <span>02. CÉREBRO DA EMPRESA</span>
              </div>
              <h3 class="text-sm font-bold text-white mb-1">Consulta às Suas Tabelas</h3>
              <p class="text-xs text-gray-400 leading-relaxed">
                O modelo consulta sua tabela de preços e regras oficiais dentro da Box. Nenhum dado vaza para servidores públicos.
              </p>
              <div class="mt-3 p-2.5 rounded-lg bg-black/60 border border-white/10 text-[11px] font-mono text-emerald-300 flex items-center justify-between">
                <span>Tabela-Precos-2026.pdf</span>
                <span class="text-[10px] text-gray-400">32ms</span>
              </div>
            </div>

            <!-- Step 3: Output -->
            <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-amber-400/30 transition-colors">
              <div class="flex items-center gap-2 mb-2 text-xs font-mono text-amber-400">
                <span>03. OBRA PRONTA</span>
              </div>
              <h3 class="text-sm font-bold text-white mb-1">Proposta em PDF em 8s</h3>
              <p class="text-xs text-gray-400 leading-relaxed">
                Orçamento timbrado com logo, discriminação de peças e aviso legal de conferência humana pronto para envio.
              </p>
              <div class="mt-3 p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-[11px] font-mono text-amber-300 flex items-center justify-between">
                <span>Proposta-Orçamento.pdf</span>
                <span class="text-[10px] font-bold text-amber-400">PRONTO</span>
              </div>
            </div>

          </div>

        </div>
      </div>
    </div>

  </div>
</section>

<!-- ------------------------------------------------------------- -->
<!-- 4. LIGHTWEIGHT PROCEDURAL AURORA RAYS SCRIPT                  -->
<!-- ------------------------------------------------------------- -->
<script>
  function initAuroraRays() {
    const canvas = document.getElementById('aurora-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    // Procedural light ray definition
    const numRays = 28;
    const rays: Array<{
      baseX: number;
      width: number;
      speed: number;
      phase: number;
      color: string;
      alpha: number;
    }> = [];

    const colors = [
      'rgba(245, 158, 11, ',  // Amber Gold
      'rgba(251, 191, 36, ',  // Light Warm Yellow
      'rgba(217, 119, 6, ',   // Deep Amber
      'rgba(59, 130, 246, ',  // Cobalt Blue
      'rgba(6, 182, 212, ',   // Cyan Aurora
    ];

    for (let i = 0; i < numRays; i++) {
      rays.push({
        baseX: (width / numRays) * i + (Math.random() - 0.5) * 60,
        width: 30 + Math.random() * 80,
        speed: 0.0006 + Math.random() * 0.0012,
        phase: Math.random() * Math.PI * 2,
        color: colors[i % colors.length],
        alpha: 0.15 + Math.random() * 0.35,
      });
    }

    let t = 0;
    function render() {
      t += 1;
      ctx.clearRect(0, 0, width, height);

      const horizonY = height * 0.42;

      for (let i = 0; i < rays.length; i++) {
        const ray = rays[i];
        const currentPhase = ray.phase + t * ray.speed;
        
        // Sway and wave calculation
        const sway = Math.sin(currentPhase) * 90;
        const topX = ray.baseX + sway + Math.cos(currentPhase * 0.5) * 50;
        const currentAlpha = ray.alpha * (0.6 + 0.4 * Math.sin(currentPhase * 1.5));

        const gradient = ctx.createLinearGradient(ray.baseX, horizonY, topX, 0);
        gradient.addColorStop(0, `${ray.color}0)`);
        gradient.addColorStop(0.2, `${ray.color}${currentAlpha * 0.7})`);
        gradient.addColorStop(0.6, `${ray.color}${currentAlpha * 0.4})`);
        gradient.addColorStop(1, `${ray.color}0)`);

        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.moveTo(ray.baseX - ray.width * 0.5, horizonY);
        ctx.lineTo(topX - ray.width * 1.8, 0);
        ctx.lineTo(topX + ray.width * 1.8, 0);
        ctx.lineTo(ray.baseX + ray.width * 0.5, horizonY);
        ctx.closePath();
        ctx.fill();
      }

      requestAnimationFrame(render);
    }

    render();
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuroraRays);
  } else {
    initAuroraRays();
  }
</script>
