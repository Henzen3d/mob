---
interface Props {
  isLegal?: boolean;
}

const { isLegal = false } = Astro.props;
---

<footer class="relative bg-[#0e1017] border-t border-white/[0.12] pt-16 pb-12 px-4 overflow-hidden z-10">
  <div class="relative z-10 max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/[0.06]">
      <div class="lg:col-span-2 flex flex-col items-start">
        <a href="/" class="flex items-center gap-2.5 mb-4 group inline-flex">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center p-1.5">
            <svg viewBox="0 0 24 24" fill="none" class="w-full h-full text-amber-400">
              <path d="M4 18V6L10 13L16 6V18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="20" cy="12" r="2.5" fill="currentColor"/>
            </svg>
          </div>
          <span class="text-base font-bold tracking-tight text-white flex items-center gap-1.5">
            MOB <span class="text-xs font-medium px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20">IA</span>
          </span>
        </a>
        <p class="text-sm text-zinc-300 max-w-md leading-relaxed mb-6">
          Inteligência Artificial de última milha para a rotina de PMEs. Servidores locais seguros, orçamentos automáticos a partir de áudios e assistentes calibrados com as regras da sua empresa.
        </p>
        <div class="flex items-center gap-2 text-xs text-zinc-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Atendimento presencial em Blumenau e Vale do Itajaí</span>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Navegação</h4>
        <ul class="space-y-3 text-sm text-zinc-400">
          <li><a href="/#como-funciona" class="hover:text-white transition-colors">Como Funciona</a></li>
          <li><a href="/#mob-box" class="hover:text-white transition-colors">A MOB Box</a></li>
          <li><a href="/#precos" class="hover:text-white transition-colors">Preços</a></li>
          <li><a href="/#faq" class="hover:text-white transition-colors">Dúvidas Frequentes</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
          <li>
            <a href="/advocacia" class="text-amber-400/90 hover:text-amber-300 transition-colors inline-flex items-center gap-1.5">
              <span>Advocacia & Sigilo</span>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Contato Direto</h4>
        <ul class="space-y-3 text-sm text-zinc-400">
          <li>
            <a
              href="https://wa.me/5547988131910?text=Ol%C3%A1!%20Gostaria%20de%20falar%20com%20o%20Osmar%20sobre%20a%20MOB."
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors flex items-center gap-2 group"
            >
              <span class="text-amber-400 font-medium">WhatsApp:</span>
              <span class="group-hover:underline text-zinc-200">(47) 98813-1910</span>
            </a>
          </li>
          <li>
            <a href="mailto:contato@mob.tec.br" class="hover:text-white transition-colors flex items-center gap-2">
              <span class="text-zinc-400">E-mail:</span>
              <span class="text-zinc-200">contato@mob.tec.br</span>
            </a>
          </li>
          <li class="flex items-center gap-2 text-zinc-300">
            <span class="text-zinc-400">Local:</span>
            <span>Blumenau — Santa Catarina</span>
          </li>
          <li>
            <span class="text-xs text-zinc-400">CNPJ & Contratos B2B</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400">
      <p>© {new Date().getFullYear()} MOB — mob.tec.br. Todos os direitos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="/#faq" class="hover:text-zinc-300 transition-colors">Segurança & Privacidade</a>
        <span class="text-zinc-600">•</span>
        <span class="text-emerald-400">Privacidade por Desenho (LGPD)</span>
      </div>
    </div>
  </div>
</footer>
