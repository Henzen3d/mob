<style>
  .waveform-bar {
    width: 3px;
    background-color: #fbbf24;
    border-radius: 9999px;
    display: inline-block;
    animation: wavePulse 1.4s ease-in-out infinite;
  }

  .waveform-bar:nth-child(2n) {
    animation-delay: 0.15s;
  }
  .waveform-bar:nth-child(3n) {
    animation-delay: 0.3s;
  }
  .waveform-bar:nth-child(4n) {
    animation-delay: 0.45s;
  }
  .waveform-bar:nth-child(5n) {
    animation-delay: 0.6s;
  }

  @keyframes wavePulse {
    0%, 100% {
      transform: scaleY(0.4);
      opacity: 0.6;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .waveform-bar {
      animation: none !important;
      transform: scaleY(0.7) !important;
      opacity: 0.8 !important;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".demo-step-tab");
  const stages = document.querySelectorAll<HTMLElement>(".demo-stage");
  function selectStage(index: number) {
    buttons.forEach((button, i) => {
      const selected = i === index;
      button.setAttribute("aria-pressed", String(selected));
      button.querySelector<HTMLElement>(".demo-progress")?.style.setProperty("transform", selected ? "scaleX(1)" : "scaleX(0)");
      button.querySelector(".demo-step-num")?.classList.toggle("text-amber-400", selected);
      button.querySelector(".demo-step-num")?.classList.toggle("text-zinc-400", !selected);
    });
    stages.forEach((stage, i) => {
      stage.classList.toggle("hidden", i !== index);
      stage.classList.toggle("opacity-0", i !== index);
    });
  }
  buttons.forEach((button, index) => button.addEventListener("click", () => selectStage(index)));
  selectStage(0);
</script>
