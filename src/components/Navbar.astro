---
interface Props {
  currentPage?: string;
  isLegal?: boolean;
}

const { currentPage = "home", isLegal = false } = Astro.props;
const homePrefix = currentPage === "home" ? "" : "/";
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 flex justify-center px-4 pt-4 md:pt-5 pointer-events-none transition-all duration-300">
  <nav
    id="main-nav"
    class={`pointer-events-auto flex items-center justify-between gap-3 sm:gap-6 md:gap-8 px-4 sm:px-5 md:px-6 py-2.5 rounded-full backdrop-blur-2xl transition-all duration-300 ${
      isLegal
        ? "bg-[#09090b]/90 border border-white/10 shadow-[0_12px_32px_rgba(0,0,0,0.6)]"
        : "bg-black/80 border border-white/[0.08] shadow-[0_12px_35px_-5px_rgba(0,0,0,0.85)]"
    }`}
  >
    <a href="/" class="flex items-center gap-2.5 group shrink-0 min-h-[44px]">
      <div class="w-7 h-7 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center p-1.5 shadow-[0_0_12px_rgba(255,255,255,0.05)] group-hover:border-amber-400/50 transition-colors">
        <svg viewBox="0 0 24 24" fill="none" class="w-full h-full text-white group-hover:text-amber-400 transition-colors">
          <path d="M4 18V6L10 13L16 6V18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="20" cy="12" r="2.2" fill="currentColor"/>
        </svg>
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-sm font-semibold tracking-tight text-white">MOB</span>
        <span class="text-xs text-zinc-400 font-normal">| IA para Empresas</span>
      </div>
    </a>

    <div class="hidden md:flex items-center gap-5 lg:gap-6 text-sm font-medium text-zinc-300">
      <a href={`${homePrefix}#como-funciona`} class="transition-colors hover:text-white py-1">
        Como Funciona
      </a>
      <a href={`${homePrefix}#precos`} class="transition-colors hover:text-white py-1">
        Preços
      </a>
      <a href={`${homePrefix}#faq`} class="transition-colors hover:text-white py-1">
        Dúvidas
      </a>
      <a
        href="/advocacia"
        class={`flex items-center gap-1.5 px-3 py-1 rounded-full text-xs transition-all ${
          currentPage === 'advocacia'
            ? 'bg-white/15 text-white font-medium border border-white/20'
            : 'text-zinc-400 hover:text-white hover:bg-white/5 border border-white/5'
        }`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400/90"></span>
        Advocacia & Sigilo
      </a>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="https://wa.me/5547988131910?text=Ol%C3%A1!%20Acessei%20o%20site%20mob.tec.br%20e%20gostaria%20de%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20presencial%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 min-h-[40px] rounded-full text-xs font-semibold bg-white text-black hover:bg-zinc-200 transition-all shadow-sm active:scale-95"
      >
        <span>Agendar Demonstração</span>
        <svg class="w-3.5 h-3.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-11 h-11 rounded-full text-zinc-300 hover:text-white hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-white/20"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-black/95 backdrop-blur-2xl hidden flex-col justify-center items-center px-6 transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Menu principal"
>
  <button
    id="close-mobile-menu"
    class="absolute top-5 right-5 flex items-center justify-center w-11 h-11 rounded-full text-zinc-400 hover:text-white hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-white/20"
    aria-label="Fechar menu"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <nav class="flex flex-col items-center gap-4 text-center w-full max-w-sm">
    <a
      href={`${homePrefix}#como-funciona`}
      class="w-full min-h-[44px] flex items-center justify-center text-lg font-medium text-zinc-200 hover:text-white hover:bg-white/5 rounded-xl transition-colors"
    >
      Como Funciona
    </a>
    <a
      href={`${homePrefix}#precos`}
      class="w-full min-h-[44px] flex items-center justify-center text-lg font-medium text-zinc-200 hover:text-white hover:bg-white/5 rounded-xl transition-colors"
    >
      Preços
    </a>
    <a
      href={`${homePrefix}#faq`}
      class="w-full min-h-[44px] flex items-center justify-center text-lg font-medium text-zinc-200 hover:text-white hover:bg-white/5 rounded-xl transition-colors"
    >
      Dúvidas
    </a>
    <a
      href="/advocacia"
      class="w-full min-h-[44px] flex items-center justify-center gap-2 text-base font-medium text-amber-300 hover:text-amber-200 hover:bg-amber-400/10 rounded-xl transition-colors"
    >
      <span class="w-2 h-2 rounded-full bg-amber-400"></span>
      Advocacia & Sigilo
    </a>

    <div class="w-full pt-4 mt-2 border-t border-white/10">
      <a
        href="https://wa.me/5547988131910?text=Ol%C3%A1!%20Acessei%20o%20site%20mob.tec.br%20e%20gostaria%20de%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20presencial%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full min-h-[48px] flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-semibold bg-white text-black hover:bg-zinc-200 transition-all shadow-lg active:scale-95"
      >
        <span>Agendar Demonstração</span>
        <svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById("main-header");
  const nav = document.getElementById("main-nav");

  const onScroll = () => {
    if (!header || !nav) return;
    if (window.scrollY > 30) {
      header.classList.remove("pt-4", "md:pt-5");
      header.classList.add("pt-2", "md:pt-3");
      nav.classList.remove("py-2.5");
      nav.classList.add("py-1.5", "shadow-xl", "bg-black/90");
    } else {
      header.classList.add("pt-4", "md:pt-5");
      header.classList.remove("pt-2", "md:pt-3");
      nav.classList.add("py-2.5");
      nav.classList.remove("py-1.5", "shadow-xl", "bg-black/90");
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const btn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("close-mobile-menu");
  const menu = document.getElementById("mobile-menu");

  const openMenu = () => {
    if (!menu || !btn) return;
    menu.classList.remove("hidden");
    menu.classList.add("flex");
    btn.setAttribute("aria-expanded", "true");
    document.body.classList.add("overflow-hidden");
  };

  const closeMenu = () => {
    if (!menu || !btn) return;
    menu.classList.add("hidden");
    menu.classList.remove("flex");
    btn.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");
  };

  if (btn && closeBtn && menu) {
    btn.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) {
        closeMenu();
      }
    });
  }
</script>