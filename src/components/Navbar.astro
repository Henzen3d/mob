---
interface Props {
  currentPage?: string;
  isLegal?: boolean;
}

const { currentPage = "home", isLegal = false } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center px-4 pt-4 md:pt-5 pointer-events-none">
  <nav
    class={`pointer-events-auto flex items-center justify-between gap-4 md:gap-8 px-4 md:px-6 py-2.5 rounded-full backdrop-blur-2xl transition-all duration-300 ${
      isLegal
        ? "bg-[#09090b]/90 border border-white/10 shadow-[0_12px_32px_rgba(0,0,0,0.6)]"
        : "bg-black/75 border border-white/[0.08] shadow-[0_12px_35px_-5px_rgba(0,0,0,0.85)]"
    }`}
  >
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center p-1.5 shadow-[0_0_12px_rgba(255,255,255,0.05)] group-hover:border-amber-400/50 transition-colors">
        <svg viewBox="0 0 24 24" fill="none" class="w-full h-full text-white group-hover:text-amber-400 transition-colors">
          <path d="M4 18V6L10 13L16 6V18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="20" cy="12" r="2.2" fill="currentColor"/>
        </svg>
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="text-sm font-semibold tracking-tight text-white">MOB</span>
        <span class="text-[11px] font-mono text-zinc-400">| IA para Empresas</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <div class="hidden lg:flex items-center gap-6 text-[13px] font-medium text-zinc-300">
      <a
        href="/"
        class={`transition-colors hover:text-white ${currentPage === 'home' ? 'text-white font-semibold' : ''}`}
      >
        Início
      </a>
      <a href="/#como-funciona" class="transition-colors hover:text-white">
        Como Funciona
      </a>
      <a href="/#mob-box" class="transition-colors hover:text-white">
        A MOB Box
      </a>
      <a
        href="/advocacia"
        class={`flex items-center gap-1.5 px-3 py-1 rounded-full text-xs transition-all ${
          currentPage === 'advocacia'
            ? 'bg-white/15 text-white font-medium border border-white/20'
            : 'text-zinc-300 hover:text-white hover:bg-white/5'
        }`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        Advocacia & Sigilo
      </a>
      <a href="/#comparativo" class="transition-colors hover:text-white">
        Comparativo
      </a>
      <a href="/#precos" class="transition-colors hover:text-white">
        Preços & ROI
      </a>
      <a href="/#faq" class="transition-colors hover:text-white">
        Dúvidas
      </a>
    </div>

    <!-- Actions / CTA Button -->
    <div class="flex items-center gap-2">
      <a
        href="https://wa.me/5547999999999?text=Ol%C3%A1!%20Acessei%20o%20site%20mob.tec.br%20e%20gostaria%20de%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20presencial%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-black hover:bg-zinc-200 transition-all shadow-md active:scale-95"
      >
        <span>Agendar Demonstração</span>
        <svg class="w-3 h-3 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-full text-zinc-300 hover:text-white hover:bg-white/5 transition-colors focus:outline-none"
        aria-label="Abrir menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Navigation Drawer -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-black/95 backdrop-blur-3xl hidden flex-col justify-center items-center px-6 transition-all duration-300"
>
  <button
    id="close-mobile-menu"
    class="absolute top-6 right-6 p-3 text-zinc-400 hover:text-white"
    aria-label="Fechar menu"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <div class="flex flex-col items-center gap-6 text-center text-lg font-medium text-zinc-200">
    <a href="/" class="hover:text-amber-400 transition-colors py-2">Início</a>
    <a href="/#como-funciona" class="hover:text-amber-400 transition-colors py-2">Como Funciona</a>
    <a href="/#mob-box" class="hover:text-amber-400 transition-colors py-2">A MOB Box</a>
    <a href="/advocacia" class="text-amber-300 font-semibold py-2">Advocacia & Sigilo</a>
    <a href="/#comparativo" class="hover:text-amber-400 transition-colors py-2">Comparativo</a>
    <a href="/#precos" class="hover:text-amber-400 transition-colors py-2">Preços & ROI</a>
    <a href="/#faq" class="hover:text-amber-400 transition-colors py-2">Dúvidas Frequentes</a>
    
    <a
      href="https://wa.me/5547999999999?text=Ol%C3%A1!%20Acessei%20o%20site%20mob.tec.br%20e%20gostaria%20de%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20presencial%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 px-6 py-3 rounded-full text-sm font-semibold bg-white text-black hover:bg-zinc-200 transition-all shadow-lg"
    >
      Agendar Demonstração no WhatsApp
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("close-mobile-menu");
  const menu = document.getElementById("mobile-menu");

  if (btn && closeBtn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.remove("hidden");
      menu.classList.add("flex");
    });

    closeBtn.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
    });

    // Close when clicking any link
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        menu.classList.remove("flex");
      });
    });
  }
</script>
