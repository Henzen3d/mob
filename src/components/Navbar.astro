---
interface Props {
  currentPage?: string;
  isLegal?: boolean;
}

const { currentPage = "home", isLegal = false } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center px-4 pt-4 md:pt-6 pointer-events-none">
  <nav
    class={`pointer-events-auto flex items-center justify-between gap-4 md:gap-8 px-4 md:px-6 py-2.5 md:py-3 rounded-full backdrop-blur-2xl transition-all duration-300 ${
      isLegal
        ? "bg-[#0b0c12]/80 border border-white/10 shadow-[0_8px_32px_rgba(0,0,0,0.5)]"
        : "bg-black/60 border border-white/10 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.8),inset_0_1px_1px_rgba(255,255,255,0.1)]"
    }`}
  >
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-400/20 to-amber-600/30 border border-amber-400/30 flex items-center justify-center p-1.5 shadow-[0_0_15px_rgba(245,158,11,0.25)] group-hover:border-amber-400/60 transition-colors">
        <svg viewBox="0 0 24 24" fill="none" class="w-full h-full text-amber-400">
          <path d="M4 18V6L10 13L16 6V18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="20" cy="12" r="2.5" fill="currentColor"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-bold tracking-tight text-white flex items-center gap-1.5">
          MOB <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20">IA</span>
        </span>
        <span class="text-[9px] text-gray-400 font-mono hidden sm:inline">mob.tec.br</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <div class="hidden lg:flex items-center gap-6 text-[13px] font-medium text-gray-300">
      <a
        href="/"
        class={`transition-colors hover:text-white ${currentPage === 'home' ? 'text-amber-400 font-semibold' : ''}`}
      >
        Início
      </a>
      <a href="/#como-funciona" class="transition-colors hover:text-white">
        Como Funciona
      </a>
      <a href="/#mob-box" class="transition-colors hover:text-white">
        A MOB Box
      </a>
      <a
        href="/advocacia"
        class={`relative flex items-center gap-1.5 px-2.5 py-1 rounded-full transition-all ${
          currentPage === 'advocacia'
            ? 'bg-amber-500/15 text-amber-300 border border-amber-500/30 font-semibold'
            : 'text-gray-300 hover:text-white hover:bg-white/5'
        }`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Advocacia & Sigilo
        <span class="text-[9px] uppercase tracking-wider font-mono px-1 py-0.2 rounded bg-white/10 text-gray-300">Exclusivo</span>
      </a>
      <a href="/#comparativo" class="transition-colors hover:text-white">
        Comparativo
      </a>
      <a href="/#precos" class="transition-colors hover:text-white">
        Preços & ROI
      </a>
      <a href="/#faq" class="transition-colors hover:text-white">
        Dúvidas
      </a>
    </div>

    <!-- Actions / CTA Button-in-Button -->
    <div class="flex items-center gap-2">
      <a
        href="https://wa.me/5547999999999?text=Ol%C3%A1!%20Acessei%20o%20site%20mob.tec.br%20e%20gostaria%20de%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20presencial%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex items-center gap-2 px-3.5 md:px-4 py-1.5 md:py-2 rounded-full text-xs font-semibold bg-gradient-to-r from-amber-500 to-amber-600 text-black hover:brightness-110 transition-all shadow-[0_0_20px_rgba(245,158,11,0.35)] active:scale-95"
      >
        <span>Agendar Demonstração</span>
        <div class="w-5 h-5 rounded-full bg-black/20 flex items-center justify-center transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
          <svg class="w-3 h-3 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </div>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-full text-gray-300 hover:text-white hover:bg-white/5 transition-colors focus:outline-none"
        aria-label="Abrir menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Navigation Overlay Drawer -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-40 bg-black/90 backdrop-blur-3xl hidden flex-col justify-center items-center px-6 transition-opacity duration-300"
>
  <button
    id="mobile-menu-close"
    class="absolute top-6 right-6 p-3 rounded-full text-gray-400 hover:text-white bg-white/5 focus:outline-none"
    aria-label="Fechar menu"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <div class="flex flex-col items-center gap-6 text-xl font-medium text-gray-200">
    <a href="/" class="hover:text-amber-400 transition-colors mobile-link">Início</a>
    <a href="/#como-funciona" class="hover:text-amber-400 transition-colors mobile-link">Como Funciona</a>
    <a href="/#mob-box" class="hover:text-amber-400 transition-colors mobile-link">A MOB Box</a>
    <a href="/advocacia" class="text-amber-400 font-semibold flex items-center gap-2 mobile-link">
      <span>⚖️ Advocacia & Sigilo</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">Exclusivo</span>
    </a>
    <a href="/#comparativo" class="hover:text-amber-400 transition-colors mobile-link">Comparativo</a>
    <a href="/#precos" class="hover:text-amber-400 transition-colors mobile-link">Preços & ROI</a>
    <a href="/#faq" class="hover:text-amber-400 transition-colors mobile-link">Dúvidas Frequentes</a>
    
    <div class="pt-6 w-full max-w-xs">
      <a
        href="https://wa.me/5547999999999?text=Ol%C3%A1!%20Acessei%20o%20site%20mob.tec.br%20e%20gostaria%20de%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20presencial%20de%2015%20minutos%20no%20meu%20escrit%C3%B3rio."
        target="_blank"
        class="w-full flex items-center justify-center gap-2 py-3.5 px-6 rounded-full font-bold bg-amber-500 text-black text-center shadow-[0_0_25px_rgba(245,158,11,0.4)]"
      >
        <span>Agendar Demonstração</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  const btnOpen = document.getElementById('mobile-menu-btn');
  const btnClose = document.getElementById('mobile-menu-close');
  const overlay = document.getElementById('mobile-menu-overlay');
  const links = document.querySelectorAll('.mobile-link');

  function openMenu() {
    overlay?.classList.remove('hidden');
    overlay?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  btnOpen?.addEventListener('click', openMenu);
  btnClose?.addEventListener('click', closeMenu);
  links.forEach(l => l.addEventListener('click', closeMenu));
</script>
