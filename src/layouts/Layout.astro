---
interface Props {
  title: string;
  description?: string;
  isLegal?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "MOB | Inteligência Artificial para Empresas",
  description = "Implantação prática de Inteligência Artificial para pequenas e médias empresas em todo o Brasil. Nuvem privada dedicada (MOB Start) e servidor local (MOB Box).",
  isLegal = false,
  ogType = "website",
  ogImage = "https://mob.tec.br/og-cover.png",
  publishedTime,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://mob.tec.br').toString();
const resolvedOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site ?? 'https://mob.tec.br').toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "MOB | Inteligência Artificial para Empresas",
  url: "https://mob.tec.br",
  logo: "https://mob.tec.br/favicon.svg",
  email: "contato@mob.tec.br",
  telephone: "+55-47-98813-1910",
  areaServed: [
    { "@type": "Country", name: "Brasil" },
    { "@type": "City", name: "Blumenau" },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Blumenau",
    addressRegion: "SC",
    addressCountry: "BR",
  },
};

const schemas = [
  organizationSchema,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<!doctype html>
<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="MOB | Inteligência Artificial para Empresas" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {(isLegal || ogType === 'article') && <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&display=swap"
      rel="stylesheet"
    />}

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <style is:global>
      :root {
        --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-serif: 'Newsreader', Georgia, serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      body {
        font-family: var(--font-sans);
        background-color: #020202;
        color: #f4f4f6;
        font-size: 16px;
        line-height: 1.6;
        overflow-x: hidden;
      }

      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #020202;
      }
      ::-webkit-scrollbar-thumb {
        background: #27272a;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #3f3f46;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        ::before,
        ::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#020202] text-zinc-100 selection:bg-amber-400 selection:text-black antialiased text-base">
    <slot />
  </body>
</html>
